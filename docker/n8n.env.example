# Dona AI Automation — Environment Variables
# Copy to .env and fill in your values

# n8n
N8N_HOST=your.domain.com
N8N_ENCRYPTION_KEY=your_random_32_char_key_here

# Database
POSTGRES_DB=dona
POSTGRES_USER=dona_user
POSTGRES_PASSWORD=your_secure_password

# API Keys (add to n8n credentials, not here)
# ANTHROPIC_API_KEY — add via n8n UI
# OPENAI_API_KEY — add via n8n UI
# GMAIL credentials — add via n8n OAuth2
# GOOGLE_SHEETS credentials — add via n8n OAuth2
